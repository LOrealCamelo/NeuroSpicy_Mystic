# NeuroSpicy Mystic landing page — environment template.
# Copy to .env.local for local dev. PRODUCTION values live in the Render dashboard
# for service srv-d7t5g94m0tmc73dqrdf0 — never commit real keys.

# --- Public URL ---
NEXT_PUBLIC_URL=http://localhost:3000

# --- Stripe ---
# OPTION A (simplest) — paste the public URL of a Stripe Payment Link.
# CTAs will redirect to it directly. NEXT_PUBLIC_ prefix is required so the
# client-side button can read the URL. One link per product.
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_WITCH_VAULT=https://buy.stripe.com/test_xxxxxxxx
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_MONEY_SPELL=
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_CEO_VAULT=
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_CONTENT_VAULT=

# OPTION B (programmatic Checkout Sessions) — fallback path used by
# /api/checkout when no Payment Link is set. Lets us customize coupon, BNPL,
# success URL, metadata, etc. Requires a real Stripe secret key + webhook.
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

STRIPE_PRICE_WITCH_VAULT=price_xxx
STRIPE_PRICE_MONEY_SPELL=
STRIPE_PRICE_CEO_VAULT=
STRIPE_PRICE_CONTENT_VAULT=
STRIPE_PRICE_RITUAL_VIDEO=

# --- Email (Workspace SMTP via info@neurospicymystic.com) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=info@neurospicymystic.com
SMTP_PASS=workspace_app_password_here
SMTP_FROM_NAME=NeuroSpicy Mystic
SUPPORT_EMAIL=support@neurospicymystic.com

# --- Mailchimp Marketing (newsletter + Money Spell lead magnet) ---
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=us1
MAILCHIMP_LIST_ID_NEWSLETTER=
MAILCHIMP_LIST_ID_MONEY_SPELL=

# --- Drive download link delivery ---
GOOGLE_DRIVE_FOLDER_ID=1qjjZgKkN8qUtAfQEVo35TVJ4z9b8UO8B
WITCH_VAULT_DOWNLOAD_URL=
MONEY_SPELL_GUIDE_URL=

# --- Optional ---
TRUSTPULSE_API_KEY=
